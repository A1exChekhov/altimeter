<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/track_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="11dp"
    android:paddingTop="4dp"
    android:paddingRight="11dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/track_widget_distance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.60"
        android:autoSizeMaxTextSize="31sp"
        android:autoSizeMinTextSize="21sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="↔ 0 м"
        android:textColor="@color/widget_text"
        android:textSize="31sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.40"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/track_widget_moving"
            style="@style/WidgetCompactStat"
            android:layout_weight="0.31"
            android:gravity="center_vertical|start"
            android:text="◷ 0 мин" />

        <TextView
            android:id="@+id/track_widget_ascent"
            style="@style/WidgetCompactStat"
            android:layout_weight="0.23"
            android:text="↑ 0 м" />

        <TextView
            android:id="@+id/track_widget_descent"
            style="@style/WidgetCompactStat"
            android:layout_weight="0.23"
            android:text="↓ 0 м" />

        <TextView
            android:id="@+id/track_widget_calories"
            style="@style/WidgetCompactStat"
            android:layout_weight="0.23"
            android:gravity="center_vertical|end"
            android:text="🔥 —" />
    </LinearLayout>
</LinearLayout>
